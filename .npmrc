# ego-browser's node_modules is hand-curated for the DSH profile context:
# @deepseek-ai/* peers are private and resolved through the profile's
# node_modules (junctions created on demand), so pnpm must NOT try to fetch
# them from the public registry during `pnpm install` here. Only the explicit
# dependencies (schemastery link, ws) are installed; peers are wired by the
# surrounding DSH profile at load time.
auto-install-peers=false
node-linker=hoisted
